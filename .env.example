# Local MongoDB replica set. Replace with a MongoDB Atlas URI in deployment.
DATABASE_URL="mongodb://localhost:27017/kesinuru?replicaSet=rs0"

# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Create a server-side key in Google AI Studio. Never expose it to the browser.
GEMINI_API_KEY="replace-with-your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# Set to production on the deployed environment.
NODE_ENV="development"
